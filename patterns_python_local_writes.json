{
  "_comment": "Python Local File Write Detection - Databricks Workspace Scanner",
  "_purpose": "Detect Python code that saves files to the current working directory for Unity Catalog migration",
  "_usage": "scan_databricks_workspace.py -p PROFILE -l python -c patterns_python_local_writes.json -o scan.txt",

  "_risk_levels": {
    "CRITICAL": "Large files, ML models, explicit Databricks local writes - immediate action required",
    "HIGH": "Common data exports, NumPy arrays, direct file operations - refactor soon",
    "MEDIUM": "Image files, Excel exports, file copying - review and consider refactoring",
    "LOW": "Temporary files, HTML exports, small logs - monitor but may be acceptable"
  },

  "_categories": {
    "1": "Basic Python File Operations (8 patterns)",
    "2": "Pandas DataFrame Exports (9 patterns)",
    "3": "NumPy Array Operations (4 patterns)",
    "4": "Serialization Libraries (5 patterns)",
    "5": "ML Model Persistence (4 patterns)",
    "6": "File Copy/Move Operations (3 patterns)",
    "7": "CSV Module Operations (2 patterns)",
    "8": "Image Processing (3 patterns)",
    "9": "Archive/Compression (3 patterns)",
    "10": "Databricks-Specific (2 patterns)",
    "11": "Logging to Files (2 patterns)",
    "12": "Database Exports (2 patterns)",
    "13": "Excel Libraries (2 patterns)",
    "14": "Temporary Files (1 pattern)"
  },

  "_unity_catalog_alternatives": {
    "open_file": "open('/Volumes/catalog/schema/volume/file.csv', 'w')",
    "pandas_csv": "df.to_csv('/Volumes/catalog/schema/volume/output.csv')",
    "pandas_table": "df.write.format('delta').saveAsTable('catalog.schema.table')",
    "numpy_save": "np.save('/Volumes/catalog/schema/volume/array.npy', data)",
    "ml_model": "model.save('/Volumes/catalog/schema/volume/model.h5')"
  },

  "_exception_info": "Exception patterns are checked BEFORE main patterns to skip false positives",

  "exceptions": [
    "/Volumes/[^\"'\\s]+",
    "/dbfs/[^\"'\\s]+",
    "dbfs:/[^\"'\\s]+",
    "/tmp/[^\"'\\s]+",
    "/databricks/driver/tmp/[^\"'\\s]+",
    "s3a?://[^\"'\\s]+",
    "abfss?://[^\"'\\s]+",
    "gs://[^\"'\\s]+",
    "wasbs?://[^\"'\\s]+",
    "adl://[^\"'\\s]+",
    "^\\s*#.*(?:to_csv|to_parquet|save|write_text|write_bytes|open\\s*\\()",
    "\"\"\"[^\"]*(?:to_csv|to_parquet|save|write_text|write_bytes|open\\s*\\()[^\"]*\"\"\"",
    "'''[^']*(?:to_csv|to_parquet|save|write_text|write_bytes|open\\s*\\()[^']*'''",
    "^\\s*[a-zA-Z_][a-zA-Z0-9_]*\\s*=\\s*[\"'][^/][^\"']*[\"']\\s*(?:#.*)?$",
    "/test[^/]*/[^\"'\\s]+",
    "/tests/[^\"'\\s]+",
    "\\$\\{[A-Z_]+\\}",
    "os\\.environ",
    "getenv\\s*\\(",
    "f[\"'][^\"']*\\{[^}]+\\}[^\"']*/[^\"']*[\"']",
    "[\"'][^\"']*\\{[^}]+\\}[^\"']*/[^\"']*[\"'].*\\.format\\s*\\(",
    "path\\.startswith\\s*\\([\"']/[\"']\\)",
    "path\\.is_absolute\\s*\\(\\)",
    "os\\.path\\.isabs\\s*\\(",
    "/dev/(?:null|stdout|stderr)",
    "[A-Z]:\\\\[^\"'\\s]+",
    "assert.*[\"'][^/][^\"']*[\"']"
  ],

  "patterns": [
    "open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,\\s*[\"'][wa][bt]?[\"']",
    "open\\s*\\(\\s*Path\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*\\)",
    "with\\s+open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,\\s*[\"'][wa][bt]?[\"']",
    "Path\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*\\)\\.write_text",
    "Path\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*\\)\\.write_bytes",
    "[\"']\\.\/[^\"']+[\"']",
    "Path\\.cwd\\s*\\(\\s*\\)",
    "os\\.getcwd\\s*\\(\\s*\\)",
    "\\.to_csv\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_parquet\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_excel\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_json\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_pickle\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_html\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_hdf\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_feather\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.to_stata\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "np\\.save\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "np\\.savetxt\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "np\\.savez\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "np\\.savez_compressed\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "json\\.dump\\s*\\([^,]+,\\s*open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,",
    "pickle\\.dump\\s*\\([^,]+,\\s*open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,",
    "yaml\\.dump\\s*\\([^,]+,\\s*open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,",
    "joblib\\.dump\\s*\\([^,]+,\\s*[\"'][^/][^\"']*[\"']",
    "dill\\.dump\\s*\\([^,]+,\\s*open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,",
    "model\\.save\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "tf\\.saved_model\\.save\\s*\\([^,]+,\\s*[\"'][^/][^\"']*[\"']",
    "\\.save\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*\\)",
    "torch\\.save\\s*\\([^,]+,\\s*[\"'][^/][^\"']*[\"']",
    "shutil\\.copy\\w*\\s*\\([^,]+,\\s*[\"'][^/][^\"']*[\"']",
    "shutil\\.move\\s*\\([^,]+,\\s*[\"'][^/][^\"']*[\"']",
    "shutil\\.copyfile\\s*\\([^,]+,\\s*[\"'][^/][^\"']*[\"']",
    "csv\\.writer\\s*\\(\\s*open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,",
    "csv\\.DictWriter\\s*\\(\\s*open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,",
    "\\.save\\s*\\(\\s*[\"'][^/][^\"']*\\.(png|jpg|jpeg|gif|bmp|tiff)[\"']",
    "\\.savefig\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "cv2\\.imwrite\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "zipfile\\.ZipFile\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "ZipFile\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "tarfile\\.open\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "gzip\\.open\\s*\\(\\s*[\"'][^/][^\"']*[\"']\\s*,\\s*[\"']w",
    "dbutils\\.fs\\.put\\s*\\(\\s*[\"']file:[^/][^\"']*[\"']",
    "dbutils\\.fs\\.cp\\s*\\([^,]+,\\s*[\"']file:",
    "logging\\.FileHandler\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "FileHandler\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "filename\\s*=\\s*[\"'][^/][^\"']*\\.log[\"']",
    "sqlite3\\.connect\\s*\\(\\s*[\"'][^/:][^\"']*\\.\\w+[\"']",
    "cursor\\.copy_to\\s*\\(\\s*open\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "\\.save\\s*\\(\\s*[\"'][^/][^\"']*\\.xlsx?[\"']",
    "xlsxwriter\\.Workbook\\s*\\(\\s*[\"'][^/][^\"']*[\"']",
    "Workbook\\s*\\(\\s*[\"'][^/][^\"']*\\.xlsx?[\"']",
    "tempfile\\.\\w+\\s*\\([^)]*dir\\s*=\\s*[\"']\\.",
    "TemporaryFile\\s*\\([^)]*dir\\s*=\\s*[\"']\\."
  ]
}
