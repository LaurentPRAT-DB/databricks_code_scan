# Databricks Workspace Configuration
# Copy this file to .env and fill in your actual values
#
# NOTE: It's recommended to use Databricks CLI profiles instead:
#   databricks configure --profile myprofile
#   Then run: uv run scan_databricks_workspace.py --profile myprofile

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token-here
